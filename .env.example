# Copy to .env and adjust. docker compose and the API both read it.

# --- Vision model ---
ANTHROPIC_API_KEY=
# live = call the API (answers are cached); replay = cache only, works offline
VLM_MODE=live

# --- Interfaces: which implementation backs each one (see backend/vera/services.py) ---
STORAGE_BACKEND=local
JOB_BACKEND=inprocess
# Empty = SQLite file in DATA_DIR. Production: postgresql+psycopg://user:pass@host/vera
DATABASE_URL=

# --- Runtime ---
DATA_DIR=data
# Process pool for OCR/CV work; 0 = number of CPUs
CPU_WORKERS=0
MAX_CONCURRENT_JOBS=4

# Host port (change if already taken on your machine)
API_HOST_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Only on networks with a TLS-intercepting filter (e.g. NetFree), uncomment so
# pip can install packages during the image build:
# PIP_TRUSTED_HOST=pypi.org files.pythonhosted.org
