# Copy to .env and adjust. docker compose reads .env automatically.

POSTGRES_USER=vera
POSTGRES_PASSWORD=vera
POSTGRES_DB=vera

# Host ports (change if already taken on your machine)
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Only on networks with a TLS-intercepting filter (e.g. NetFree), uncomment so
# pip can install packages during the image build:
# PIP_TRUSTED_HOST=pypi.org files.pythonhosted.org
