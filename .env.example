# Copy to .env and adjust. docker compose and the API both read it.

# --- Vision model ---
ANTHROPIC_API_KEY=
# live = call the API (answers are cached); replay = cache only, works offline
VLM_MODE=live

# --- Interfaces: which implementation backs each one (see backend/vera/services.py) ---
STORAGE_BACKEND=local
JOB_BACKEND=inprocess
# Empty = SQLite file in DATA_DIR. Production: postgresql+psycopg://user:pass@host/vera
DATABASE_URL=

# --- Runtime ---
DATA_DIR=data
# Process pool for OCR/CV work; 0 = number of CPUs
CPU_WORKERS=0
MAX_CONCURRENT_JOBS=4
# Pages below this sharpness get a blur warning at intake
BLUR_THRESHOLD=40

# --- Assistant and reports ---
# Model for the assistant and drafted letters. Without ANTHROPIC_API_KEY the
# assistant answers common questions from the data and letters use templates.
ASSISTANT_MODEL=claude-opus-5-5
# Weekly report "hours saved": manual entry time per form, minus time per
# field a person still looked at.
MANUAL_SECONDS_PER_FORM=100
REVIEW_SECONDS_PER_FIELD=15

# Host ports (change if already taken on your machine)
API_HOST_PORT=8000
WEB_HOST_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# NetFree: put its root CAs in backend/certs/ (see the README there) and set
# this to 1, so the build and every container start trust NetFree's current
# intermediates (they rotate every ~2 days).
NETFREE_REFRESH_CERTS=0

# Last-resort fallback for other TLS-intercepting filters: lets pip / npm skip
# TLS verification during the image build only.
# PIP_TRUSTED_HOST=pypi.org files.pythonhosted.org
# NPM_STRICT_SSL=false
